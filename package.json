{
  "name": "ericcaskey-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/derive-last-modified.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/derive-last-modified.mjs && node scripts/fetch-writing-feed.mjs",
    "build": "next build",
    "lint": "eslint .",
    "pretypecheck": "node scripts/derive-last-modified.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
